# ============================================================
# Copiá este archivo a .env.local y completá los valores.
# .env.local está en .gitignore: nunca se commitea.
#
# El sitio ARRANCA SIN NADA DE ESTO. Sin Supabase configurado usa los datos
# de prueba de lib/datos.ts y el formulario de alertas valida y responde
# igual, así se puede ver todo andando antes de tener la base.
# ============================================================

# --- Supabase ---
# Panel del proyecto -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role. SOLO en el servidor: puede leer respuesta_correcta y saltear
# RLS. Si esta clave aparece en un archivo NEXT_PUBLIC_* o en el cliente,
# el simulador queda con las respuestas a la vista.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (avisos por mail, Bloque 2) ---
RESEND_API_KEY=
RESEND_FROM="Nexo Derecho × Nueva Abogacía <avisos@example.org>"

# --- URL pública del sitio (callback del magic link) ---
NEXT_PUBLIC_SITIO_URL=http://localhost:3000
